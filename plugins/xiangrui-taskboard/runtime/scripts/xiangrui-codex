#!/bin/zsh
set -euo pipefail

readonly XIANGRUI_REPO="$(cd "$(dirname "$0")/.." && pwd)"
readonly XIANGRUI_NODE="${XIANGRUI_NODE:-$(command -v node || true)}"
if [[ -d "/Applications/ChatGPT.app" ]]; then
  readonly CODEX_APP="/Applications/ChatGPT.app"
elif [[ -d "/Applications/Codex.app" ]]; then
  readonly CODEX_APP="/Applications/Codex.app"
else
  readonly CODEX_APP="/Applications/ChatGPT.app"
fi
readonly CODEX_BUNDLE_ID="com.openai.codex"
readonly CDP_PORT="9231"

codex_is_running() {
  local running
  running="$(/usr/bin/osascript -e 'application id "com.openai.codex" is running' 2>/dev/null)" || return 1
  [[ "$running" == "true" ]]
}

if [[ ! -x "$XIANGRUI_NODE" ]]; then
  /usr/bin/osascript -e 'display alert "xiangrui Codex 启动失败" message "需要 Node.js 22.5 或更高版本" as critical'
  exit 1
fi

if [[ ! -d "$CODEX_APP" ]]; then
  /usr/bin/osascript -e 'display alert "xiangrui Codex 启动失败" message "找不到 /Applications/ChatGPT.app" as critical'
  exit 1
fi

if codex_is_running; then
  if ! /usr/bin/osascript <<'APPLESCRIPT' >/dev/null
display dialog "需要先退出当前 Codex，才能以任务面板模式重新打开。未发送的输入可能丢失。" with title "打开 xiangrui Codex" buttons {"取消", "退出并打开"} default button "退出并打开" cancel button "取消" with icon caution
APPLESCRIPT
  then
    exit 0
  fi
  /usr/bin/osascript -e 'tell application id "com.openai.codex" to quit'
  for attempt in {1..120}; do
    if ! codex_is_running; then
      break
    fi
    if [[ "$attempt" == "120" ]]; then
      /usr/bin/osascript -e 'display alert "xiangrui Codex 启动失败" message "Codex 没有在 30 秒内退出，请手动退出后再试。" as critical'
      exit 1
    fi
    /bin/sleep 0.25
  done
fi

cd "$XIANGRUI_REPO"
CODEX_TASKBOARD_HOST=127.0.0.1 \
  "$XIANGRUI_NODE" scripts/codex-injector.mjs --launch --open --port "$CDP_PORT" --app-path "$CODEX_APP"

/usr/bin/osascript -e 'display notification "任务面板已经进入 Codex 左侧边栏" with title "xiangrui Codex"'
